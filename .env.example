# Copy to .env and fill in your Supabase project values.
# Then run supabase/migrations/20260908120000_app_users.sql in the SQL editor.
# Restart the app, sign out, and sign in as admin.
# Users, income, expenses, accounts, budgets, and categories then sync across devices.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
